FROM node:26-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npx nuxt prepare && npm run build


FROM node:26-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3007

COPY --from=build /app/.output ./.output

EXPOSE 3007

CMD ["node", ".output/server/index.mjs"]
